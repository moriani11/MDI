<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gamehub - Login</title>
    <link rel="stylesheet" href="/css/general.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>

  <body>
    <main>
      <section class="login-form">
        <h2>Inloggen</h2>

        <% if (message) { %>
          <p class="<%= message.type %>-message"><%= message.message %></p>
        <% } %>

        <form class="login" action="/auth/login" method="post">
          <label for="email">E-mail*</label>
          <input type="email" id="email" name="email" required placeholder="jouw@email.com" />

          <label for="password">Wachtwoord*</label>
          <input type="password" id="password" name="password" required />

          <button class="auth-button" type="submit">Inloggen</button>

          <p>Nog geen account? <a href="/registration">Registreer hier</a></p>
        </form>
      </section>
    </main>
  </body>
</html>
